<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Backend test suite. Runs against EF Core InMemory + Mock<T> where the
    Bookkeeping / Ermes E2E / Packages surface needs to be exercised
    without spinning up MySQL. See tests/Kalypsis.Tests/README.md for
    what is (and isn't) covered.

    Not part of the API build — only referenced by `dotnet test` from
    the repo root or this csproj directly. Build outputs are redirected
    to G:\kalypsis-build-out via the local-only Directory.Build.props.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Backend\Kalypsis.Api\Kalypsis.Api.csproj" />
    <ProjectReference Include="..\..\src\Backend\Kalypsis.Application\Kalypsis.Application.csproj" />
    <ProjectReference Include="..\..\src\Backend\Kalypsis.Domain\Kalypsis.Domain.csproj" />
    <ProjectReference Include="..\..\src\Backend\Kalypsis.Infrastructure\Kalypsis.Infrastructure.csproj" />
  </ItemGroup>
</Project>
