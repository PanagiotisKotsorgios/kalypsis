{
  "name": "kalypsis-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:customer-edit": "node --experimental-strip-types --test src/components/customer/customerEditSession.test.mjs src/components/customer/customerInlineFields.test.mjs src/components/customer/customerValidation.test.mjs",
    "test:profile-edit": "node --experimental-strip-types --test --test-concurrency=1 src/components/profile/profileDrafts.test.mjs src/components/profile/profileComponents.test.mjs src/components/profile/recordProfiles.test.mjs src/components/profile/vehicleOwnership.test.mjs src/components/profile/policyRiskProfile.test.mjs src/components/profile/producerWorkspace.test.mjs",
    "test:producer-statement": "node --experimental-strip-types --test src/pages/producerStatementNavigation.test.mjs",
    "test:searchable-options": "node --experimental-strip-types --test src/components/searchableOptions.test.mjs",
    "test:over-commissions": "node --experimental-strip-types --test src/pages/overCommissionTable.test.mjs src/pages/partnerResponsive.test.mjs src/utils/tableExportSnapshot.test.mjs",
    "test:production-lists": "node --experimental-strip-types --test src/pages/productionListsSimplification.test.mjs",
    "test:advance-payments": "node --experimental-strip-types --test src/pages/advancePaymentsAllocation.test.mjs",
    "test:unified-actions": "node --experimental-strip-types --test src/pages/unifiedActionsMenus.test.mjs",
    "test:customer-filters": "node --experimental-strip-types --test src/pages/customerListFilters.test.mjs src/pages/customerTableAppearance.test.mjs",
    "test:financial-claim-actions": "node --experimental-strip-types --test src/pages/financialAndClaimsActions.test.mjs",
    "test:claim-layout": "node --experimental-strip-types --test src/pages/claimsResponsive.test.mjs",
    "test:edit-card-routing": "node --experimental-strip-types --test src/components/profile/editCardRouting.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.27.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
